{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playground-rag",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "biblioteca-matematica"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
