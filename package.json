{
  "name": "playground-rag",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:api": "wrangler dev --config wrangler.api.jsonc",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node --check public/app.js && node --check public/i18n.js && node --check public/math.js",
    "check:api": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.32.0"
  }
}
